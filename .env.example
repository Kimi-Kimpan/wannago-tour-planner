# 이 파일을 .env.local로 복사해 로컬 개발에 씁니다. .env.local은 git에 올라가지 않아요.
# 배포 때는 GitHub 저장소 Secrets(같은 이름)에서 읽어 옵니다.

# Supabase: Project Settings > API Keys. 브라우저용 publishable(anon) 키만. secret/service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Google Maps Platform: HTTP 리퍼러와 API(Maps JavaScript, Places (New), Maps Static)로 제한한 키
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
# PDF용 정지 지도: 같은 스타일을 연결한 '정적(Static)' 유형 Map ID (없으면 기본 스타일)
VITE_GOOGLE_STATIC_MAP_ID=

# 배포 경로. 로컬은 "/", github.io 기본 주소는 "/wannago-tour-planner/", 자체 도메인은 "/"
VITE_BASE_PATH=/
